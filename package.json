{
  "name": "eviescratch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-foundation.mjs",
    "check": "npm run typecheck && npm run verify",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "node scripts/browser-tests.mjs test",
    "test:browser:install": "node scripts/browser-tests.mjs install chromium webkit"
  },
  "dependencies": {
    "@tiptap/core": "3.35.0",
    "@tiptap/extension-list": "3.35.0",
    "@tiptap/extension-placeholder": "3.35.0",
    "@tiptap/pm": "3.35.0",
    "@tiptap/react": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "dexie": "4.4.7",
    "fflate": "0.8.3",
    "lucide-react": "1.77.0",
    "minisearch": "7.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fake-indexeddb": "6.2.8",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
